# sinh bởi viper-kit từ permissions của VIPER — đừng sửa tay
prefix_rule(pattern=["make","deploy"], decision="prompt")
prefix_rule(pattern=["git","push"], decision="prompt")
prefix_rule(pattern=["vercel"], decision="prompt")
prefix_rule(pattern=["railway"], decision="prompt")
prefix_rule(pattern=["fly"], decision="prompt")
prefix_rule(pattern=["flyctl"], decision="prompt")
prefix_rule(pattern=["render"], decision="prompt")
prefix_rule(pattern=["gh","repo","create"], decision="prompt")
prefix_rule(pattern=["gh","release"], decision="prompt")
prefix_rule(pattern=["npm","publish"], decision="prompt")
prefix_rule(pattern=["sudo"], decision="forbidden")
prefix_rule(pattern=["rm","-rf","/"], decision="forbidden")
prefix_rule(pattern=["rm","-rf","~"], decision="forbidden")
prefix_rule(pattern=["git","push","--force"], decision="forbidden")
prefix_rule(pattern=["git","reset","--hard","origin"], decision="forbidden")
