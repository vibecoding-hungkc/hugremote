# hugremote — danh sách biến môi trường (TÊN + mô tả, KHÔNG giá trị thật).
# Copy để chạy: cp deployment/.env.example deployment/local/.env
# Biến tuỳ chọn để dạng `# TÊN=` (make doctor không bắt). Chi tiết: context/TECHSTACK.md §6.

# --- target: hugremote ---
APP_ENV=                 # development | production
# PORT=                  # cổng nghe (mặc định 8099; dev 3000)
# HOST=                  # địa chỉ nghe (mặc định 127.0.0.1)
# BASE_PATH=             # đường dẫn con sau reverse proxy, vd /remote
# APP_URL=               # origin công khai — kiểm Origin WS, cờ Secure cookie
# DATA_DIR=              # thư mục dữ liệu (mặc định ~/.config/hugremote)
# WORKSPACE_ROOT=        # thư mục dự án mặc định của máy local
# ALLOWED_ROOT=          # ranh giới duyệt file local (mặc định $HOME)
# JWT_SECRET=            # trống = dẫn từ DATA_DIR/secret.key
# AUTH_MODE=             # password (mặc định) | none (chỉ khi HOST loopback)
# AUTH_PASSWORD=         # mật khẩu khởi tạo (chỉ dùng khi chưa có tài khoản)
# AUTH_MAX_ATTEMPTS=     # mặc định 5
# AUTH_LOCK_MINUTES=     # mặc định 15
# TRUST_PROXY=           # 1 khi chạy sau reverse proxy
# SSH_CONFIG_PATH=       # mặc định ~/.ssh/config (dev/test trỏ vào file mẫu)
# CLAUDE_BIN_PATH=       # đường dẫn Claude CLI local
# CLAUDE_PROJECTS_DIR=   # mặc định ~/.claude/projects
# UPDATE_CHANNEL=        # stable | beta
# UPDATE_REPO=           # nguồn phát hành
# WEB_DIST=              # (dev) thư mục bản build web, mặc định apps/web/dist
