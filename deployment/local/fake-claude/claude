#!/usr/bin/env python3
"""fake-claude — giả Claude Code CLI ở chế độ `-p --input-format stream-json --output-format stream-json`.

Dùng cho dev/test/dogfood HugRemote mà không tốn hạn mức Claude thật. Phát đúng các dạng dòng mà CLI thật phát:
system/init · stream_event (message_start, content_block_start/delta/stop) · assistant · user (tool_result) ·
control_request can_use_tool (khi `--permission-prompts host` và chế độ quyền không cho phép sẵn) · result.
Kịch bản theo nội dung prompt:
  "nhanh"  → chỉ trả lời một câu
  "chậm"   → như mặc định nhưng chạy lâu (để thử Dừng / xếp hàng)
  "lỗi"    → kết thúc lượt bằng lỗi
  mặc định → suy nghĩ → text → chạy lệnh (Bash) → xin quyền ghi file → ghi thật → tóm tắt
"""
import json, os, sys, time, uuid, threading

argv = sys.argv[1:]
def opt(name, default=None):
    return argv[argv.index(name) + 1] if name in argv and argv.index(name) + 1 < len(argv) else default

if '--version' in argv:
    print('2.1.0 (fake-claude)'); sys.exit(0)

session_id = opt('--session-id') or opt('--resume') or str(uuid.uuid4())
mode = opt('--permission-mode', 'manual')
model = opt('--model', 'claude-sonnet-fake')
out_lock = threading.Lock()
answers = {}
interrupted = threading.Event()

def emit(obj):
    with out_lock:
        sys.stdout.write(json.dumps(obj, ensure_ascii=False) + '\n'); sys.stdout.flush()

def stream_text(text, kind='text', index=0, delay=0.03):
    emit({'type': 'stream_event', 'session_id': session_id, 'event': {'type': 'content_block_start', 'index': index, 'content_block': {'type': kind, kind: ''}}})
    for i in range(0, len(text), 6):
        if interrupted.is_set(): return
        d = {'type': 'thinking_delta', 'thinking': text[i:i+6]} if kind == 'thinking' else {'type': 'text_delta', 'text': text[i:i+6]}
        emit({'type': 'stream_event', 'session_id': session_id, 'event': {'type': 'content_block_delta', 'index': index, 'delta': d}})
        time.sleep(delay)
    emit({'type': 'stream_event', 'session_id': session_id, 'event': {'type': 'content_block_stop', 'index': index}})

def assistant(blocks):
    emit({'type': 'assistant', 'session_id': session_id, 'message': {'role': 'assistant', 'model': model, 'content': blocks}})

def ask(tool, inp):
    """Xin quyền (hoặc AskUserQuestion) như CLI thật; chờ control_response từ host."""
    if tool != 'AskUserQuestion' and (mode in ('bypassPermissions', 'acceptEdits') and tool in ('Write', 'Edit') or mode == 'bypassPermissions'):
        return True, inp
    rid = 'perm_' + uuid.uuid4().hex[:10]
    ev = threading.Event(); answers[rid] = [ev, False, {}]
    emit({'type': 'control_request', 'request_id': rid, 'request': {'subtype': 'can_use_tool', 'tool_name': tool, 'input': inp, 'tool_use_id': 'toolu_' + rid}})
    while not ev.wait(0.2):
        if interrupted.is_set(): return False, {}
    return answers[rid][1], answers[rid][2]

def reader():
    global mode
    for line in sys.stdin:
        try: m = json.loads(line)
        except Exception: continue
        if m.get('type') == 'user':
            c = m['message']['content']
            prompts.append(c if isinstance(c, str) else ''.join(b.get('text', '') for b in c))
            got_prompt.set()
        elif m.get('type') == 'control_response':
            r = m['response']; rid = r.get('request_id')
            if rid in answers:
                resp = r.get('response', {})
                answers[rid][1] = resp.get('behavior') == 'allow'
                answers[rid][2] = resp.get('updatedInput', {})
                answers[rid][0].set()
        elif m.get('type') == 'control_request':
            req = m.get('request', {})
            if req.get('subtype') == 'interrupt': interrupted.set()
            if req.get('subtype') == 'set_permission_mode': mode = req.get('mode', mode)
            resp = {}
            if req.get('subtype') == 'initialize': resp = INIT
            if req.get('subtype') == 'get_context_usage':
                resp = {'totalTokens': 12000 + 19000 * len(prompts), 'maxTokens': 200000 if 'haiku' in model else 1000000, 'model': model}
            emit({'type': 'control_response', 'response': {'subtype': 'success', 'request_id': m.get('request_id'), 'response': resp}})
    stdin_closed.set()

EFF = ['low', 'medium', 'high', 'xhigh', 'max']
INIT = {
    'commands': [
        {'name': 'compact', 'description': 'Nén hội thoại để tiết kiệm context', 'argumentHint': '<hướng dẫn>'},
        {'name': 'init', 'description': 'Tạo CLAUDE.md cho dự án', 'argumentHint': ''},
        {'name': 'review', 'description': 'Rà lại thay đổi hiện tại', 'argumentHint': ''},
        {'name': 'clear', 'description': 'Xoá hội thoại', 'argumentHint': ''},
    ],
    'models': [
        {'value': 'default', 'resolvedModel': 'claude-opus-fake[1m]', 'displayName': 'Default (recommended)', 'description': 'Opus giả · 1M context', 'supportsEffort': True, 'supportedEffortLevels': EFF},
        {'value': 'sonnet', 'resolvedModel': 'claude-sonnet-fake', 'displayName': 'Sonnet', 'description': 'Cân bằng', 'supportsEffort': True, 'supportedEffortLevels': EFF},
        {'value': 'haiku', 'resolvedModel': 'claude-haiku-fake', 'displayName': 'Haiku', 'description': 'Nhanh, rẻ', 'supportsEffort': False},
    ],
    'account': {'subscriptionType': 'fake'},
    'current_permission_mode': mode,
}

prompts = []; got_prompt = threading.Event(); stdin_closed = threading.Event()
threading.Thread(target=reader, daemon=True).start()
while not got_prompt.wait(0.2):
    if stdin_closed.is_set(): sys.exit(0)
prompt = prompts[0]
t0 = time.time()
TID_LS = 'toolu_ls_' + uuid.uuid4().hex[:8]; TID_W = 'toolu_w_' + uuid.uuid4().hex[:8]
emit({'type': 'system', 'subtype': 'init', 'session_id': session_id, 'model': model, 'cwd': os.getcwd(), 'permissionMode': mode, 'tools': ['Bash', 'Read', 'Write', 'Edit']})
emit({'type': 'rate_limit_event', 'session_id': session_id, 'rate_limit_info': {'status': 'allowed_warning', 'rateLimitType': 'five_hour', 'utilization': 0.81, 'resetsAt': int(time.time()) + 2 * 3600}})
emit({'type': 'rate_limit_event', 'session_id': session_id, 'rate_limit_info': {'status': 'allowed', 'rateLimitType': 'seven_day', 'utilization': 0.46, 'resetsAt': int(time.time()) + 4 * 86400}})
slow = 'chậm' in prompt or 'cham' in prompt
delay = 0.25 if slow else 0.03
files = []
def finish(is_error=False, msg=''):
    emit({'type': 'result', 'subtype': 'error_during_execution' if is_error else 'success', 'is_error': is_error, 'session_id': session_id,
          'duration_ms': int((time.time() - t0) * 1000), 'num_turns': 1, 'result': msg,
          'total_cost_usd': 0.0123, 'usage': {'input_tokens': 4200, 'output_tokens': 380, 'cache_read_input_tokens': 15000}})
    # 'treo': báo result rồi không thoát dù stdin đóng — như CLI thật chờ mạng/hook/tác vụ nền lúc thoát (dogfood 2026-11-26)
    if 'treo' in prompt: time.sleep(90)
    stdin_closed.wait(5); sys.exit(0)

emit({'type': 'stream_event', 'session_id': session_id, 'event': {'type': 'message_start', 'message': {'role': 'assistant'}}})
if 'nhanh' in prompt:
    txt = f'Đã nhận: "{prompt[:60]}". Thư mục làm việc: {os.getcwd()}'
    stream_text(txt); assistant([{'type': 'text', 'text': txt}]); finish()
if 'agent' in prompt.lower():
    tid_sub = 'toolu_sub_' + uuid.uuid4().hex[:8]
    tid_r = 'toolu_r_' + uuid.uuid4().hex[:8]
    intro = 'Mình sẽ giao cho agent con tìm nhanh trong dự án.'
    stream_text(intro, 'text', 0, delay)
    assistant([{'type': 'text', 'text': intro}, {'type': 'tool_use', 'id': tid_sub, 'name': 'Agent', 'input': {'subagent_type': 'Explore', 'description': 'Quét cấu trúc dự án'}}])
    time.sleep(delay * 3)
    emit({'type': 'assistant', 'session_id': session_id, 'parent_tool_use_id': tid_sub,
          'message': {'role': 'assistant', 'model': model, 'content': [{'type': 'text', 'text': 'Đang đọc thư mục gốc và tệp chính.'}, {'type': 'tool_use', 'id': tid_r, 'name': 'Read', 'input': {'file_path': os.path.join(os.getcwd(), 'README.md')}}]}})
    time.sleep(delay * 3)
    emit({'type': 'user', 'session_id': session_id, 'parent_tool_use_id': tid_sub,
          'message': {'role': 'user', 'content': [{'type': 'tool_result', 'tool_use_id': tid_r, 'content': '# Demo project', 'is_error': False}]}})
    emit({'type': 'user', 'session_id': session_id, 'message': {'role': 'user', 'content': [{'type': 'tool_result', 'tool_use_id': tid_sub, 'content': 'Đã tìm thấy README.md và thư mục src/.', 'is_error': False}]}})
    out_txt = 'Agent con đã quét xong cấu trúc dự án.'
    emit({'type': 'stream_event', 'session_id': session_id, 'event': {'type': 'message_start', 'message': {'role': 'assistant'}}})
    stream_text(out_txt, 'text', 0, delay); assistant([{'type': 'text', 'text': out_txt}]); finish()
if 'hỏi' in prompt.lower() or 'chọn' in prompt.lower() or 'question' in prompt.lower():
    q_inp = {'questions': [{'question': 'Bạn muốn ưu tiên phương án nào?', 'header': 'Phương án', 'multiSelect': False,
                            'options': [{'label': 'Giữ đơn giản', 'description': 'Ít thay đổi, ra nhanh'},
                                        {'label': 'Tách mô-đun', 'description': 'Gọn về sau nhưng sửa nhiều hơn'}]}]}
    ok, upd = ask('AskUserQuestion', q_inp)
    if interrupted.is_set(): finish(True, 'interrupted')
    ans = (upd or {}).get('answers', {}) if ok else {}
    ans_txt = ', '.join(f'{v}' for v in ans.values()) if ans else 'không chọn'
    reply = f'Đã nhận lựa chọn: {ans_txt}.' if ok else 'Bạn đã từ chối câu hỏi.'
    stream_text(reply, 'text', 0, delay); assistant([{'type': 'text', 'text': reply}]); finish()
think = 'Người dùng muốn tôi làm việc trong dự án. Tôi sẽ xem cấu trúc, chạy test, rồi sửa file.'
stream_text(think, 'thinking', 0, delay)
txt = 'Mình xem cấu trúc dự án và chạy test trước.'
stream_text(txt, 'text', 1, delay)
assistant([{'type': 'thinking', 'thinking': think}, {'type': 'text', 'text': txt}, {'type': 'tool_use', 'id': TID_LS, 'name': 'Bash', 'input': {'command': 'ls && git status --short'}}])
if interrupted.is_set(): finish(True, 'interrupted')
out = os.popen('ls 2>&1; git status --short 2>&1').read()[:2000]
time.sleep(delay * 4)
emit({'type': 'user', 'session_id': session_id, 'message': {'role': 'user', 'content': [{'type': 'tool_result', 'tool_use_id': TID_LS, 'content': out, 'is_error': False}]}})
if 'lỗi' in prompt or 'loi' in prompt: finish(True, 'Giả lập lỗi khi chạy lượt')
target = 'NOTES-claude.md'
content = f'# Ghi chú từ Claude (giả)\n\nYêu cầu: {prompt}\n\nThời điểm: {time.strftime("%Y-%m-%d %H:%M:%S")}\n'
emit({'type': 'stream_event', 'session_id': session_id, 'event': {'type': 'message_start', 'message': {'role': 'assistant'}}})
txt2 = f'Mình sẽ ghi kết quả vào {target}.'
stream_text(txt2, 'text', 0, delay)
assistant([{'type': 'text', 'text': txt2}, {'type': 'tool_use', 'id': TID_W, 'name': 'Write', 'input': {'file_path': os.path.join(os.getcwd(), target), 'content': content}}])
ok, _ = ask('Write', {'file_path': os.path.join(os.getcwd(), target), 'content': content})
if interrupted.is_set(): finish(True, 'interrupted')
if ok:
    open(target, 'w').write(content); files.append(target)
    emit({'type': 'user', 'session_id': session_id, 'message': {'role': 'user', 'content': [{'type': 'tool_result', 'tool_use_id': TID_W, 'content': f'File created successfully at: {target}'}]}})
else:
    emit({'type': 'user', 'session_id': session_id, 'message': {'role': 'user', 'content': [{'type': 'tool_result', 'tool_use_id': TID_W, 'content': 'Người dùng đã từ chối', 'is_error': True}]}})
emit({'type': 'stream_event', 'session_id': session_id, 'event': {'type': 'message_start', 'message': {'role': 'assistant'}}})
final = f'Xong. {"Đã ghi " + target if ok else "Không ghi file vì bị từ chối"}. Kiểm tra: src/bookings/bookings.controller.ts:3'
stream_text(final, 'text', 0, delay)
assistant([{'type': 'text', 'text': final}])
finish()
