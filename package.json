{
  "name": "hugcode",
  "version": "1.0.0",
  "description": "Mobile-First Web IDE, Terminal Emulator & AI Coding Assistant for Smartphones",
  "type": "module",
  "main": "server/dist/index.js",
  "bin": {
    "hugcode": "./bin/hugcode.js"
  },
  "files": [
    "bin",
    "server/dist",
    "server/public",
    "server/package.json",
    "install.sh",
    "README.md"
  ],
  "scripts": {
    "build": "npm run build:client && npm run build:server",
    "build:client": "npm run build --prefix client",
    "build:server": "npm run build --prefix server",
    "start": "node bin/hugcode.js",
    "dev": "npm run dev --prefix server"
  },
  "keywords": [
    "web-ide",
    "terminal",
    "mobile-first",
    "pty",
    "ssh",
    "claude-code",
    "pwa"
  ],
  "author": "Duy Hung",
  "license": "MIT",
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/static": "^8.1.1",
    "@fastify/websocket": "^11.0.1",
    "fastify": "^5.2.1",
    "node-pty": "^1.1.0",
    "ssh2": "^1.16.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
