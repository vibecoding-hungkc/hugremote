{
  "name": "hugremote",
  "version": "1.5.3",
  "description": "Mobile-First Web IDE, Terminal Emulator & AI Coding Assistant for Smartphones",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "main": "apps/api/dist/index.js",
  "bin": {
    "hugremote": "./bin/hugremote.js",
    "hugcode": "./bin/hugremote.js"
  },
  "files": [
    "bin",
    "apps/api/dist",
    "apps/api/public",
    "apps/api/package.json",
    "packages/shared/dist",
    "server/dist",
    "server/public",
    "install.sh",
    "README.md"
  ],
  "scripts": {
    "build": "npm run build:shared && npm run build:web && npm run build:api",
    "build:shared": "npm run build --prefix packages/shared",
    "build:web": "npm run typecheck:web && npm run build --prefix apps/web",
    "typecheck:web": "vue-tsc --noEmit -p apps/web/tsconfig.json",
    "test:ui": "node scripts/test_ui_unsaved.mjs && node scripts/test_ui_terminal.mjs && node scripts/test_ui_virtual_keyboard.mjs && node scripts/test_ui_editor_keys.mjs && node scripts/test_ui_claude_context.mjs && node scripts/test_ui_workspace_git.mjs && node scripts/test_ui_workspace_components.mjs && node scripts/test_ui_review_terminal.mjs && node scripts/test_ui_review_project.mjs",
    "test:claude-stream": "tsx scripts/test_claude_streaming.ts && node scripts/test_ui_claude_stream.mjs",
    "test:claude-resume": "tsx scripts/test_claude_history.ts && tsx scripts/test_claude_sse_lifecycle.ts && node scripts/test_ui_claude_resume.mjs && node scripts/test_ui_claude_activity.mjs",
    "test:git": "tsx scripts/test_git_remote.ts",
    "test:claude-models": "tsx scripts/test_claude_models.ts && node scripts/test_ui_claude_models.mjs",
    "test:claude-context": "tsx scripts/test_claude_context_usage.ts && node scripts/test_ui_claude_context_usage.mjs",
    "test:claude-capability-matrix": "node scripts/test_claude_capability_matrix.mjs",
    "test:claude-fixture-safety": "node scripts/test_claude_fixture_safety.mjs",
    "test:claude-differential": "tsx scripts/test_claude_protocol_differential.mjs",
    "test:claude-protocol-core": "tsx scripts/test_claude_protocol_core.ts",
    "test:claude-protocol-fuzz": "tsx scripts/test_claude_protocol_fuzz.ts",
    "test:claude-tool-agent-core": "tsx scripts/test_claude_tool_agent_core.ts",
    "test:claude-duplex-spike": "tsx scripts/spike_claude_duplex_transport.ts",
    "test:claude-interaction-core": "tsx scripts/test_claude_interaction_core.ts",
    "test:claude-replay-migration": "tsx scripts/test_claude_replay_migration.ts",
    "test:security": "tsx scripts/test_http_security.ts",
    "build:api": "npm run build --prefix apps/api",
    "build:client": "npm run build:web",
    "build:server": "npm run build:api",
    "start": "node bin/hugremote.js",
    "dev": "npm run dev --prefix apps/api"
  },
  "keywords": [
    "web-ide",
    "terminal",
    "mobile-first",
    "pty",
    "ssh",
    "claude-code",
    "hugremote",
    "pwa"
  ],
  "author": "Duy Hung",
  "license": "MIT",
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/static": "^10.1.6",
    "@fastify/websocket": "^11.0.1",
    "fastify": "^5.12.7",
    "grammy": "^1.46.0",
    "node-pty": "^1.1.0",
    "ssh2": "^1.16.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "allowScripts": {
    "cpu-features@0.0.10": true,
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true,
    "node-pty@1.1.0": true,
    "ssh2@1.17.0": true
  }
}
